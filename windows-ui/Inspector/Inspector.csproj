<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WinUI 3 inspector for the Windows build. A pure view: the Python tray app (desktop/winui_bridge.py) owns
    the core, scheduling and settings, streams ready-to-render state as JSON lines on stdin and receives the
    user's actions as JSON lines on stdout. Built unpackaged and self-contained so dist/windows needs no
    Windows App SDK or .NET install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>IsGPTNerfed.Inspector</AssemblyName>
    <RootNamespace>IsGPTNerfed.Inspector</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- The UI is built in code; no XAML pages, so provide our own entry point. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>..\..\packaging\IsGPTNerfed.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\packaging\IsGPTNerfed.ico" Link="IsGPTNerfed.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    dotnet publish leaves the app's PRI index behind in $(TargetDir), so the published folder has no .pri. An
    unpackaged WinUI app then cannot resolve ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml, throws in
    App.OnLaunched and exits before any window appears. Ship the index next to the exe.
  -->
  <Target Name="CopyPriIndexToPublish" AfterTargets="Publish" Condition="Exists('$(TargetDir)$(TargetName).pri')">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
